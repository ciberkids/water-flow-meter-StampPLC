{
  "id": "info-p0-global-status",
  "name": "P0 \u2014 Global Status",
  "description": "Landing page in four groups: identity + current flow, the walking dots, the since-reset pair, then network and LED.",
  "elements": [
    {
      "id": "hdr-title",
      "kind": "text",
      "x": 2,
      "y": 2,
      "emphasis": "strong",
      "content": "System Status"
    },
    {
      "id": "total-flow-label",
      "kind": "text",
      "x": 2,
      "y": 14,
      "emphasis": "muted",
      "content": "Total Current Flow (L/m)"
    },
    {
      "id": "total-flow-value",
      "kind": "value",
      "x": 152,
      "y": 14,
      "emphasis": "strong",
      "binding": "telemetry.totalFlowLps"
    },
    {
      "id": "flow-dots",
      "kind": "icon",
      "x": 60,
      "y": 30,
      "width": 120,
      "height": 40
    },
    {
      "id": "session-total",
      "kind": "text",
      "x": 2,
      "y": 80,
      "binding": "telemetry.totalVolumeLiters"
    },
    {
      "id": "max-flow",
      "kind": "text",
      "x": 2,
      "y": 92,
      "binding": "telemetry.maxFlowLpm"
    },
    {
      "id": "net-led-status",
      "kind": "text",
      "x": 2,
      "y": 108,
      "emphasis": "muted",
      "binding": "legend.status"
    },
    {
      "id": "footer-hint",
      "kind": "text",
      "x": 2,
      "y": 124,
      "emphasis": "muted",
      "content": "UP/DN pages   UP+DN off"
    },
    {
      "id": "level-position",
      "kind": "scrollbar",
      "x": 232,
      "y": 14,
      "width": 5,
      "height": 104
    }
  ]
}