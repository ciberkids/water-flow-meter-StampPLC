{
  "name": "stampplc-ui-mockup",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:exporter": "tsc --project tsconfig.exporter.json",
    "export:firmware": "tsc --project tsconfig.exporter.json && node dist-exporter/tools/exporter/cli.js",
    "test:unit": "vitest run",
    "test:visual": "tsc && vite build && playwright test",
    "test:visual:update": "tsc && vite build && playwright test --update-snapshots",
    "test:exporter": "tsc --project tsconfig.exporter.json && node --test \"dist-exporter/tools/exporter/__tests__/*.js\"",
    "test:cypress": "tsc && vite build && start-server-and-test \"node ./node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 4173\" http://127.0.0.1:4173 \"cypress run --e2e\""
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.25",
    "@types/react-dom": "^18.2.11",
    "@vitejs/plugin-react": "^4.2.1",
    "cypress": "^13.13.2",
    "start-server-and-test": "^2.0.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vitest": "^1.6.1"
  }
}
