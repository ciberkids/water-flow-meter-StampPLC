{
    "screens": [
        {
            "id": "info-overview",
            "name": "Info Overview",
            "description": "Instant flow telemetry with sensor readiness badges.",
            "elements": [
                {
                    "id": "title",
                    "kind": "text",
                    "x": 4,
                    "y": 4,
                    "content": "Instant Flow",
                    "emphasis": "strong",
                    "binding": "page.title"
                },
                {
                    "id": "value-total",
                    "kind": "value",
                    "x": 4,
                    "y": 20,
                    "content": "000.0 L/s",
                    "binding": "telemetry.total"
                },
                {
                    "id": "badge-ready",
                    "kind": "badge",
                    "x": 4,
                    "y": 34,
                    "content": "All sensors ready",
                    "binding": "telemetry.status"
                },
                {
                    "id": "box-left",
                    "kind": "box",
                    "x": 4,
                    "y": 48,
                    "width": 58,
                    "height": 60
                },
                {
                    "id": "box-right",
                    "kind": "box",
                    "x": 72,
                    "y": 48,
                    "width": 58,
                    "height": 60
                },
                {
                    "id": "sensor-1",
                    "kind": "text",
                    "x": 8,
                    "y": 52,
                    "content": "S1 00.0",
                    "binding": "sensor.1"
                },
                {
                    "id": "sensor-2",
                    "kind": "text",
                    "x": 8,
                    "y": 64,
                    "content": "S2 00.0",
                    "binding": "sensor.2"
                },
                {
                    "id": "sensor-3",
                    "kind": "text",
                    "x": 8,
                    "y": 76,
                    "content": "S3 00.0",
                    "binding": "sensor.3"
                },
                {
                    "id": "sensor-4",
                    "kind": "text",
                    "x": 8,
                    "y": 88,
                    "content": "S4 00.0",
                    "binding": "sensor.4"
                },
                {
                    "id": "sensor-5",
                    "kind": "text",
                    "x": 76,
                    "y": 52,
                    "content": "S5 00.0",
                    "binding": "sensor.5"
                },
                {
                    "id": "sensor-6",
                    "kind": "text",
                    "x": 76,
                    "y": 64,
                    "content": "S6 00.0",
                    "binding": "sensor.6"
                },
                {
                    "id": "sensor-7",
                    "kind": "text",
                    "x": 76,
                    "y": 76,
                    "content": "S7 00.0",
                    "binding": "sensor.7"
                },
                {
                    "id": "sensor-8",
                    "kind": "text",
                    "x": 76,
                    "y": 88,
                    "content": "S8 00.0",
                    "binding": "sensor.8"
                },
                {
                    "id": "legend-led",
                    "kind": "text",
                    "x": 0,
                    "y": 138,
                    "content": "LED status legend",
                    "binding": "legend.led"
                },
                {
                    "id": "legend-warning",
                    "kind": "text",
                    "x": 0,
                    "y": 150,
                    "content": "Warnings",
                    "binding": "legend.warning"
                },
                {
                    "id": "propeller",
                    "kind": "icon",
                    "x": 210,
                    "y": 48,
                    "width": 44,
                    "height": 44,
                    "content": "propeller"
                }
            ],
            "flows": [
                {
                    "id": "info-nav-prev",
                    "label": "UP switches to previous page",
                    "trigger": { "type": "button", "button": "up", "gesture": "short" },
                    "actionId": "ui.action.page.previous"
                },
                {
                    "id": "info-nav-next",
                    "label": "DOWN switches to next page",
                    "trigger": { "type": "button", "button": "down", "gesture": "short" },
                    "actionId": "ui.action.page.next"
                },
                {
                    "id": "info-enter-config",
                    "label": "ENTER opens configuration",
                    "trigger": { "type": "button", "button": "enter", "gesture": "short" },
                    "targetScreenId": "configuration",
                    "actionId": "ui.action.mode.configuration"
                },
                {
                    "id": "info-enter-idle",
                    "label": "ENTER long press idles display",
                    "trigger": { "type": "button", "button": "enter", "gesture": "long" },
                    "actionId": "ui.action.mode.idle"
                }
            ]
        },
        {
            "id": "configuration",
            "name": "Configuration Menu",
            "description": "Entry point to sensor setup and LED tuning.",
            "elements": [
                {
                    "id": "title",
                    "kind": "text",
                    "x": 4,
                    "y": 4,
                    "content": "Configuration",
                    "emphasis": "strong",
                    "binding": "config.title"
                },
                {
                    "id": "info",
                    "kind": "text",
                    "x": 4,
                    "y": 16,
                    "content": "Select an option:",
                    "emphasis": "muted"
                },
                {
                    "id": "option-1",
                    "kind": "badge",
                    "x": 4,
                    "y": 32,
                    "content": "Sensors"
                },
                {
                    "id": "option-2",
                    "kind": "badge",
                    "x": 4,
                    "y": 46,
                    "content": "LED Pulse"
                },
                {
                    "id": "option-3",
                    "kind": "badge",
                    "x": 4,
                    "y": 60,
                    "content": "Nyquist Warnings"
                },
                {
                    "id": "decor",
                    "kind": "icon",
                    "x": 115,
                    "y": 16
                }
            ],
            "flows": [
                {
                    "id": "config-nav-prev",
                    "label": "UP selects previous field",
                    "trigger": { "type": "button", "button": "up", "gesture": "short" },
                    "actionId": "ui.action.page.previous"
                },
                {
                    "id": "config-nav-next",
                    "label": "DOWN selects next field",
                    "trigger": { "type": "button", "button": "down", "gesture": "short" },
                    "actionId": "ui.action.page.next"
                },
                {
                    "id": "config-save",
                    "label": "ENTER saves configuration",
                    "trigger": { "type": "button", "button": "enter", "gesture": "short" },
                    "actionId": "core.action.save-config",
                    "actionParams": { "scope": "ui" }
                },
                {
                    "id": "config-exit",
                    "label": "ENTER hold returns to info",
                    "trigger": { "type": "button", "button": "enter", "gesture": "long" },
                    "targetScreenId": "info-overview",
                    "actionId": "ui.action.mode.info"
                }
            ]
        },
        {
            "id": "countdown",
            "name": "Reset Countdown",
            "description": "Factory reset hold overlay with progress indicator.",
            "elements": [
                {
                    "id": "title",
                    "kind": "text",
                    "x": 4,
                    "y": 4,
                    "content": "Factory Reset",
                    "emphasis": "strong",
                    "binding": "countdown.title"
                },
                {
                    "id": "message",
                    "kind": "text",
                    "x": 4,
                    "y": 20,
                    "content": "Hold buttons to continue...",
                    "emphasis": "muted",
                    "binding": "countdown.message"
                },
                {
                    "id": "timer-box",
                    "kind": "box",
                    "x": 18,
                    "y": 48,
                    "width": 100,
                    "height": 60
                },
                {
                    "id": "timer-value",
                    "kind": "value",
                    "x": 68,
                    "y": 72,
                    "content": "30 s",
                    "align": "center",
                    "binding": "countdown.value"
                },
                {
                    "id": "hint",
                    "kind": "text",
                    "x": 68,
                    "y": 90,
                    "content": "Release to cancel",
                    "align": "center",
                    "emphasis": "muted",
                    "binding": "countdown.hint"
                }
            ]
        }
    ],
    "theme": {
        "name": "StampPLC Default",
        "colors": {
            "displayBackground": "#000a17",
            "textPrimary": "#f5faff",
            "textMuted": "#9caec6",
            "textStrong": "#ffffff",
            "value": "#56d2ff",
            "badgeBackground": "#0f1e33",
            "badgeBorder": "#80a8c9",
            "icon": "#56d2ff",
            "legend": "#85bbe8",
            "gridMinor": "rgba(124, 162, 206, 0.28)",
            "gridMajor": "rgba(124, 162, 206, 0.55)"
        },
        "typography": {
            "base": 8,
            "value": 10,
            "badge": 8
        },
        "animation": {
            "easing": "ease-in-out"
        }
    }
}
