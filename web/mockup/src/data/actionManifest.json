{
  "version": "3",
  "catalogueAbi": 1,
  "actions": [
    {
      "id": "ui.action.page.next",
      "label": "Next page",
      "description": "Advances to the next UI page"
    },
    {
      "id": "ui.action.page.previous",
      "label": "Previous page",
      "description": "Returns to the previous UI page"
    },
    {
      "id": "ui.action.mode.idle",
      "label": "Enter idle",
      "description": "Dims the display and enters idle mode"
    },
    {
      "id": "core.action.save-config",
      "label": "Save configuration",
      "description": "Persists the current configuration block to NVS and Modbus registers"
    },
    {
      "id": "core.action.reset-session",
      "label": "Reset session counters",
      "description": "Issues the Reset Session Modbus command for all ready sensors"
    },
    {
      "id": "core.action.reset-all-measured",
      "label": "Reset all measured totals",
      "description": "Issues the Reset All Measured Modbus command"
    },
    {
      "id": "core.action.reset-max-flow",
      "label": "Reset peak flow",
      "description": "Issues the Reset Max Flow Modbus command; clears the volatile peak and nothing else"
    },
    {
      "id": "core.action.reset-calibration",
      "label": "Reset calibration",
      "description": "Returns the SELECTED channel's calibration to defaults so a replacement meter can be entered; cumulative, session and peak readings are kept"
    },
    {
      "id": "core.action.factory-reset",
      "label": "Factory reset",
      "description": "Wipes NVS, clears Modbus config, and reboots"
    },
    {
      "id": "core.action.reset-portal-login",
      "label": "Reset portal login",
      "description": "Restores the configuration portal login to admin/admin, leaving totals, calibration and network settings untouched (R8.2a)"
    },
    {
      "id": "ui.action.nav.descend",
      "label": "Descend one level",
      "description": "Push the flow's target level onto the navigation stack"
    },
    {
      "id": "ui.action.nav.back",
      "label": "Back one level",
      "description": "Pop one level off the navigation stack"
    },
    {
      "id": "ui.action.nav.escape",
      "label": "Escape to main screen",
      "description": "Clear the navigation stack back to P0, discarding any uncommitted edit"
    },
    {
      "id": "config.action.value.increment",
      "label": "Increment value",
      "description": "Raise the pending value by its step, with hold acceleration"
    },
    {
      "id": "config.action.value.decrement",
      "label": "Decrement value",
      "description": "Lower the pending value by its step, with hold acceleration"
    },
    {
      "id": "config.action.value.commit",
      "label": "Commit value",
      "description": "Clamp, write the mapped register, validate, then ascend one level"
    },
    {
      "id": "config.action.value.commit-override",
      "label": "Save despite Nyquist warning",
      "description": "Forces the pending value past a failed Nyquist check and raises bit n of register 30 (§5.5)"
    },
    {
      "id": "config.action.value.discard",
      "label": "Discard edit",
      "description": "Abandon the pending value and ascend one level"
    },
    {
      "id": "ui.action.pack.select-menu",
      "label": "Open the Select Menu",
      "description": "Opens the firmware-drawn menu-pack selector. Declared by the firmware-appended root entry (Loadable_UI_Menu_Packs.md §3.4); the same page the UP+DOWN+ENTER 3 s gesture opens"
    }
  ],
