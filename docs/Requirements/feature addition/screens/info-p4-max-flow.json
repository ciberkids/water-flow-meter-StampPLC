{
  "id": "info-p4-max-flow",
  "name": "P4 \u2014 Max Flow Since Reset",
  "description": "Per-channel peaks since the last session reset, with MAX marking a channel that hit its q_max ceiling \u2014 i.e. a sensor under-dimensioned for its pipe.",
  "elements": [
    {
      "id": "hdr-title",
      "kind": "text",
      "x": 2,
      "y": 2,
      "emphasis": "strong",
      "content": "Max Flow",
      "worst": "Max Flow",
      "bound": "fixed literal; the unit lives here, not on eight rows"
    },
    {
      "id": "hdr-unit",
      "kind": "text",
      "x": 56,
      "y": 2,
      "emphasis": "muted",
      "binding": "telemetry.flowUnitLabel",
      "worst": "m3/h",
      "bound": "widest kFlowUnitOptions label; follows config.flowUnit"
    },
    {
      "id": "s1-label",
      "kind": "text",
      "x": 2,
      "y": 24,
      "emphasis": "muted",
      "content": "1:",
      "worst": "1:",
      "bound": "fixed literal: the channel number, 1..8"
    },
    {
      "id": "s1-value",
      "kind": "value",
      "x": 18,
      "y": 24,
