{
  "id": "config-sensor-5",
  "name": "SEN5 \u2014 Sensor 5",
  "description": "Sensor selector, channel 5 of 8. UP/DOWN pages the channels; ENTER opens this one's settings. The status row is why you would pick it.",
  "elements": [
    {
      "id": "hdr-title",
      "kind": "text",
      "x": 2,
      "y": 2,
      "emphasis": "strong",
      "content": "Config > Sensors",
      "worst": "Config > Sensors",
      "bound": "fixed literal"
    },
    {
      "id": "nav-position",
      "kind": "text",
      "x": 168,
      "y": 2,
      "emphasis": "muted",
      "binding": "nav.position",
      "worst": "L3 8/8",
      "bound": "depth 0..3 (UiNavigator::kMaxDepth) and position within a ring of at most 8"
    },
    {
      "id": "channel-label",
      "kind": "value",
      "x": 2,
      "y": 28,
      "emphasis": "strong",
      "content": "Sensor 5",
      "worst": "Sensor 8",
      "bound": "fixed literal, 1..8"
    },
    {
      "id": "status-label",
      "kind": "text",
      "x": 2,
      "y": 56,
      "emphasis": "muted",
      "content": "Status",
      "worst": "Status",
      "bound": "fixed literal"
    },
    {
      "id": "status-value",
      "kind": "value",
      "x": 62,
      "y": 56,
      "emphasis": "strong",
      "binding": "sensor.5.status",
      "worst": "SET?",
      "bound": "-- disconnected, SET? uncalibrated, OK otherwise"
    },
    {
      "id": "flow-label",
      "kind": "text",
      "x": 2,
      "y": 78,
      "emphasis": "muted",
      "content": "Flow (L/m)",
      "worst": "Flow (L/m)",
      "bound": "fixed literal"
    },
    {
      "id": "flow-value",
      "kind": "value",
      "x": 68,
      "y": 78,
      "binding": "sensor.5.instantFlow",
      "worst": "5: 65535.00",
      "bound": "one channel clamped to q_max=65535 L/min"
    },
    {
      "id": "cal-label",
      "kind": "text",
      "x": 2,
      "y": 100,
      "emphasis": "muted",
      "content": "Pulses/L",
      "worst": "Pulses/L",
      "bound": "fixed literal"
    },
    {
      "id": "cal-value",
      "kind": "value",
      "x": 68,
      "y": 100,
      "binding": "sensor.5.pulsesPerLitre",
      "worst": "5: 1966020",
      "bound": "set on a pulses-calibrated channel; 60*multiplier on a formula one, so the worst case is 60*32767 = 1966020"
    },
    {
      "id": "footer-hint",
      "kind": "text",
      "x": 2,
      "y": 124,
      "emphasis": "muted",
      "content": "UP/DN channels  ENTER open",
      "worst": "UP/DN channels  ENTER open",
      "bound": "shared footer vocabulary, see 7.1",
      "bannerReplaces": true
    },
    {
      "id": "level-position",
      "kind": "scrollbar",
      "x": 232,
      "y": 14,
      "width": 5,
      "height": 100,
      "bound": "geometry; 100px so it stops clear of the banner row at y=116"
    }
  ]
}
