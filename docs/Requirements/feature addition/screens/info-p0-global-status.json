{
  "id": "info-p0-global-status",
  "name": "P0 \u2014 Global Status",
  "description": "Four groups: identity + current flow, the walking dots, the since-reset pair, then network and LED.",
  "elements": [
    {
      "id": "hdr-title",
      "kind": "text",
      "x": 2,
      "y": 2,
      "emphasis": "strong",
      "content": "System Status",
      "worst": "System Status",
      "bound": "fixed literal"
    },
    {
      "id": "total-flow-label",
      "kind": "text",
      "x": 2,
      "y": 14,
      "emphasis": "muted",
      "content": "Total Current Flow (L/m)",
      "worst": "Total Current Flow (L/m)",
      "bound": "fixed literal"
    },
    {
      "id": "total-flow-value",
      "kind": "value",
      "x": 152,
      "y": 14,
      "emphasis": "strong",
      "binding": "telemetry.totalFlowLpm",
      "worst": "524280.00",
      "bound": "8 channels each clamped to q_max=65535 L/min"
    },
    {
      "id": "flow-dots",
      "kind": "icon",
      "x": 60,
      "y": 30,
      "width": 120,
      "height": 40,
      "metadata": {
        "assetId": "flow-dots"
      },
      "bound": "geometry; assetId required by ui_renderer.cpp:324"
    },
    {
      "id": "session-total-label",
      "kind": "text",
      "x": 2,
      "y": 80,
      "content": "Since reset (m3)",
      "worst": "Since reset (m3)",
      "bound": "fixed literal"
    },
    {
      "id": "session-total-value",
      "kind": "value",
      "x": 153,
      "y": 80,
      "binding": "telemetry.totalVolumeM3",
      "worst": "99999999.99",
      "bound": "panel cap agreed at 8 integer digits + 2 decimals, m3 (2a.1)"
    },
    {
      "id": "max-flow",
      "kind": "text",
      "x": 2,
      "y": 92,
      "binding": "telemetry.maxFlowLpm",
      "worst": "Max Flow: 65535.00 L/m (S8)",
      "bound": "one channel clamped to q_max=65535"
    },
    {
      "id": "net-led-status",
      "kind": "text",
      "x": 2,
      "y": 108,
      "emphasis": "muted",
      "binding": "legend.status",
      "worst": "WiFi RETRY  MQTT OFF  LED 1p/100L",
      "bound": "wifiStateText max RETRY(5), mqttStateText max OFF(3), volume max 100"
    },
    {
      "id": "level-position",
      "kind": "scrollbar",
      "x": 232,
      "y": 14,
      "width": 5,
      "height": 100,
      "bound": "geometry; 100px so it stops clear of the banner row at y=116"
    },
    {
      "id": "footer-hint",
      "kind": "text",
      "x": 2,
      "y": 124,
      "emphasis": "muted",
      "content": "UP/DN pages   UP+DN off",
      "worst": "UP/DN pages   UP+DN off",
      "bound": "fixed literal",
      "bannerReplaces": true
    }
  ]
}
