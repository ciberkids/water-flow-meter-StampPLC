{
  "id": "config-s2-calibration",
  "name": "S2 \u2014 Calibration",
  "description": "Sensor settings entry S2, scoped to the sensor of the current level. \u2014 laid out to the \u00a77 per-sensor template.",
  "elements": [
    {
      "id": "hdr-title",
      "kind": "text",
      "x": 2,
      "y": 2,
      "emphasis": "strong",
      "content": "Sensor > Calibration",
      "worst": "Sensor > Calibration",
      "bound": "fixed literal"
    },
    {
      "id": "sensor-index",
      "kind": "value",
      "x": 200,
      "y": 2,
      "binding": "config.selectedSensor",
      "worst": "8",
      "bound": "which sensor this setting applies to; 1..8, or - when none is implied"
    },
    {
      "id": "field-value",
      "kind": "value",
      "x": 2,
      "y": 24,
      "emphasis": "strong",
      "binding": "config.sensor.calibrationType",
      "worst": "Pulses/L",
      "bound": "widest calibration option"
    },
    {
      "id": "range-hint",
      "kind": "text",
      "x": 2,
      "y": 44,
      "emphasis": "muted",
      "binding": "config.editor.range",
      "worst": "None / Even / Odd",
      "bound": "derived from the descriptor - see 7.2; widest is parity"
    },
    {
      "id": "context-note",
      "kind": "text",
      "x": 2,
      "y": 66,
      "emphasis": "muted",
      "content": "Formula: F = m*Q + a.  Pulses/L: K p/L.",
      "worst": "Formula: F = m*Q + a.  Pulses/L: K p/L.",
      "bound": "fixed literal"
    },
    {
      "id": "nyquist-warning",
      "kind": "text",
      "x": 2,
      "y": 88,
      "emphasis": "strong",
      "binding": "config.sensor.nyquistWarning",
      "worst": "Write refused. UP=Back",
      "bound": "editor state; empty in the normal case"
    },
    {
      "id": "footer-hint",
      "kind": "text",
      "x": 2,
      "y": 124,
      "emphasis": "muted",
      "content": "UP/DN pages  ENTER edit  hold=exit",
      "worst": "UP/DN pages  ENTER edit  hold=exit",
      "bound": "shared footer vocabulary, see 7.1",
      "bannerReplaces": true
    },
    {
      "id": "level-position",
      "kind": "scrollbar",
      "x": 232,
      "y": 14,
      "width": 5,
      "height": 100,
      "bound": "geometry; 100px so it stops clear of the banner row at y=116"
    }
  ]
}
