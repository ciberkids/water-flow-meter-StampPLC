{
  "id": "net-wifi-info",
  "name": "W.I1 \u2014 WiFi",
  "description": "WiFi information, page 1 of 2. Read-only: the panel reads WiFi, it does not set it.",
  "elements": [
    {
      "id": "hdr-title",
      "kind": "text",
      "x": 2,
      "y": 2,
      "content": "WiFi > WiFi",
      "worst": "WiFi > WiFi",
      "bound": "fixed literal"
    },
    {
      "id": "nav-position",
      "kind": "text",
      "x": 168,
      "y": 2,
      "emphasis": "muted",
      "binding": "nav.position",
      "worst": "L3 8/8",
      "bound": "depth 0..3 (UiNavigator::kMaxDepth) and position within a ring of at most 8"
    },
    {
      "id": "row0-label",
      "kind": "text",
      "x": 2,
      "y": 26,
      "content": "State",
      "emphasis": "muted",
      "worst": "State",
      "bound": "fixed literal"
    },
    {
      "id": "row0-value",
      "kind": "text",
      "x": 84,
      "y": 26,
      "binding": "net.wifi.state",
      "emphasis": "strong",
      "worst": "RETRY",
      "bound": "wifiStateText, longest is RETRY"
    },
    {
      "id": "row1-label",
      "kind": "text",
      "x": 2,
      "y": 44,
      "content": "Enabled",
      "emphasis": "muted",
      "worst": "Enabled",
      "bound": "fixed literal"
    },
    {
      "id": "row1-value",
      "kind": "text",
      "x": 84,
      "y": 44,
      "binding": "config.wifi.enabled",
      "emphasis": "strong",
      "worst": "Off",
      "bound": "boolean, Off / On"
    },
    {
      "id": "row2-label",
      "kind": "text",
      "x": 2,
      "y": 62,
      "content": "Network",
      "emphasis": "muted",
      "worst": "Network",
      "bound": "fixed literal"
    },
    {
      "id": "row2-value",
      "kind": "text",
      "x": 84,
      "y": 62,
      "binding": "config.wifi.ssid",
      "emphasis": "strong",
      "worst": "xxxxxxxxxxxxxxxxxxxxxxxx",
      "bound": "SSID holds 32 bytes; clipped to the 24-char value column by ui_renderer; real bound is longer"
    },
    {
      "id": "row3-label",
      "kind": "text",
      "x": 2,
      "y": 80,
      "content": "Passphrase",
      "emphasis": "muted",
      "worst": "Passphrase",
      "bound": "fixed literal"
    },
    {
      "id": "row3-value",
      "kind": "text",
      "x": 84,
      "y": 80,
      "binding": "config.wifi.psk",
      "emphasis": "strong",
      "worst": "********",
      "bound": "writeOnly, always eight asterisks"
    },
    {
      "id": "footer-hint",
      "kind": "text",
      "x": 2,
      "y": 124,
      "content": "UP/DN pages",
      "emphasis": "muted",
      "worst": "UP/DN pages",
      "bound": "fixed literal",
      "bannerReplaces": true
    },
    {
      "id": "level-position",
      "kind": "scrollbar",
      "x": 232,
      "y": 14,
      "width": 5,
      "height": 100,
      "bound": "geometry; 100px so it stops clear of the banner row at y=116"
    }
  ]
}
