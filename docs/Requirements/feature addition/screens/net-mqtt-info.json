{
  "id": "net-mqtt-info",
  "name": "M.I1 \u2014 MQTT",
  "description": "MQTT information, page 1 of 3. Read-only; every value it shows was its own screen before.",
  "elements": [
    {
      "id": "hdr-title",
      "kind": "text",
      "x": 2,
      "y": 2,
      "content": "MQTT > MQTT",
      "worst": "MQTT > MQTT",
      "bound": "fixed literal"
    },
    {
      "id": "nav-position",
      "kind": "text",
      "x": 168,
      "y": 2,
      "emphasis": "muted",
      "binding": "nav.position",
      "worst": "L3 8/8",
      "bound": "depth 0..3 (UiNavigator::kMaxDepth) and position within a ring of at most 8"
    },
    {
      "id": "row0-label",
      "kind": "text",
      "x": 2,
      "y": 26,
      "content": "State",
      "emphasis": "muted",
      "worst": "State",
      "bound": "fixed literal"
    },
    {
      "id": "row0-value",
      "kind": "text",
      "x": 84,
      "y": 26,
      "binding": "net.mqtt.state",
      "emphasis": "strong",
      "worst": "UNSET",
      "bound": "mqttStateText: OFF / OK / DOWN / UNSET"
    },
    {
      "id": "row1-label",
      "kind": "text",
      "x": 2,
      "y": 44,
      "content": "Enabled",
      "emphasis": "muted",
      "worst": "Enabled",
      "bound": "fixed literal"
    },
    {
      "id": "row1-value",
      "kind": "text",
      "x": 84,
      "y": 44,
      "binding": "config.mqtt.enabled",
      "emphasis": "strong",
      "worst": "Off",
      "bound": "boolean, Off / On"
    },
    {
      "id": "row2-label",
      "kind": "text",
      "x": 2,
      "y": 62,
      "content": "Broker",
      "emphasis": "muted",
      "worst": "Broker",
      "bound": "fixed literal"
    },
    {
      "id": "row2-value",
      "kind": "text",
      "x": 84,
      "y": 62,
      "binding": "config.mqtt.host",
      "emphasis": "strong",
      "worst": "xxxxxxxxxxxxxxxxxxxxxxxx",
      "bound": "host holds 64 bytes; clipped to the 24-char value column by ui_renderer; real bound is longer"
    },
    {
      "id": "row3-label",
      "kind": "text",
      "x": 2,
      "y": 80,
      "content": "Port",
      "emphasis": "muted",
      "worst": "Port",
      "bound": "fixed literal"
    },
    {
      "id": "row3-value",
      "kind": "text",
      "x": 84,
      "y": 80,
      "binding": "config.mqtt.port",
      "emphasis": "strong",
      "worst": "65535",
      "bound": "uint16 domain 1..65535"
    },
    {
      "id": "footer-hint",
      "kind": "text",
      "x": 2,
      "y": 124,
      "content": "Set via web portal or RS485",
      "emphasis": "muted",
      "worst": "Set via web portal or RS485",
      "bound": "fixed literal",
      "bannerReplaces": true
    },
    {
      "id": "level-position",
      "kind": "scrollbar",
      "x": 232,
      "y": 14,
      "width": 5,
      "height": 100,
      "bound": "geometry; 100px so it stops clear of the banner row at y=116"
    }
  ]
}
