{
  "id": "config-s2-multiplier",
  "name": "S2 \u2014 Multiplier (F)",
  "description": "Sensor settings entry S2, scoped to the sensor of the current level. \u2014 laid out to the \u00a77 persensor template.",
  "elements": [
    {
      "id": "hdr-title",
      "kind": "text",
      "x": 2,
      "y": 2,
      "emphasis": "strong",
      "content": "Sensor > Multiplier (F)",
      "worst": "Sensor > Multiplier (F)",
      "bound": "fixed literal"
    },
    {
      "id": "sensor-index",
      "kind": "value",
      "x": 200,
      "y": 2,
      "binding": "config.selectedSensor",
      "worst": "8",
      "bound": "which sensor this setting applies to; 1..8, or - when none is implied"
    },
    {
      "id": "field-value",
      "kind": "value",
      "x": 2,
      "y": 24,
      "emphasis": "strong",
      "binding": "config.sensor.multiplier",
      "worst": "-32768",
      "bound": "descriptor min, the widest signed value"
    },
    {
      "id": "range-hint",
      "kind": "text",
      "x": 2,
      "y": 44,
      "emphasis": "muted",
      "binding": "config.editor.range",
      "worst": "8 rates: 1200..115200",
      "bound": "derived from the descriptor \u2014 see 7.2"
    },
    {
      "id": "nyquist-warning",
      "kind": "text",
      "x": 2,
      "y": 66,
      "emphasis": "strong",
      "binding": "config.sensor.nyquistWarning",
      "worst": "Write refused. UP=Back",
      "bound": "editor state; empty in the normal case"
    },
    {
      "id": "footer-hint",
      "kind": "text",
      "x": 2,
      "y": 124,
      "emphasis": "muted",
      "content": "UP/DN pages  ENTER edit  hold=exit",
      "worst": "UP/DN pages  ENTER edit  hold=exit",
      "bound": "shared footer vocabulary, see 7.1",
      "bannerReplaces": true
    },
    {
      "id": "level-position",
      "kind": "scrollbar",
      "x": 232,
      "y": 14,
      "width": 5,
      "height": 100,
      "bound": "geometry; 100px so it stops clear of the banner row at y=116"
    }
  ]
}