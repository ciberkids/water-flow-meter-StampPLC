{
  "id": "config-s4-multiplier",
  "name": "S4 \u2014 Multiplier (F)",
  "description": "Sensor settings entry S4, scoped to the sensor of the current level. \u2014 laid out to the \u00a77 per-sensor template.",
  "elements": [
    {
      "id": "hdr-title",
      "kind": "text",
      "x": 2,
      "y": 2,
      "emphasis": "strong",
      "content": "Sensor > Multiplier (F)",
      "worst": "Sensor > Multiplier (F)",
      "bound": "fixed literal"
    },
    {
      "id": "sensor-index",
      "kind": "value",
      "x": 200,
      "y": 2,
      "binding": "config.selectedSensor",
      "worst": "8",
      "bound": "which sensor this setting applies to; 1..8, or - when none is implied"
    },
    {
      "id": "field-value",
      "kind": "value",
      "x": 2,
      "y": 24,
      "emphasis": "strong",
      "binding": "config.sensor.multiplier",
      "worst": "32767",
      "bound": "multiplier domain 1..32767"
    },
    {
      "id": "range-hint",
      "kind": "text",
      "x": 2,
      "y": 44,
      "emphasis": "muted",
      "binding": "config.editor.range",
      "worst": "None / Even / Odd",
      "bound": "derived from the descriptor - see 7.2; widest is parity"
    },
    {
      "id": "f-eq",
      "kind": "text",
      "x": 2,
      "y": 66,
      "emphasis": "muted",
      "content": "F =",
      "worst": "F =",
      "bound": "fixed literal"
    },
    {
      "id": "f-mult",
      "kind": "value",
      "x": 24,
      "y": 66,
      "emphasis": "strong",
      "binding": "config.sensor.multiplier",
      "worst": "32767",
      "bound": "multiplier domain 1..32767; reads -- when calibrated by pulses per litre"
    },
    {
      "id": "f-q",
      "kind": "text",
      "x": 62,
      "y": 66,
      "emphasis": "muted",
      "content": "*Q",
      "worst": "*Q",
      "bound": "fixed literal"
    },
    {
      "id": "f-adj",
      "kind": "text",
      "x": 80,
      "y": 66,
      "emphasis": "muted",
      "binding": "config.sensor.adjustTerm",
      "worst": "- 32768",
      "bound": "signed adjust term; reads -- when calibrated by pulses per litre"
    },
    {
      "id": "f-range",
      "kind": "text",
      "x": 128,
      "y": 66,
      "emphasis": "muted",
      "binding": "config.sensor.formulaQ",
      "worst": "Q 0..65535 L/m",
      "bound": "q_max is a uint16; reads -- when calibrated by pulses per litre"
    },
    {
      "id": "nyquist-warning",
      "kind": "text",
      "x": 2,
      "y": 88,
      "emphasis": "strong",
      "binding": "config.sensor.nyquistWarning",
      "worst": "Write refused. UP=Back",
      "bound": "editor state; empty in the normal case"
    },
    {
      "id": "footer-hint",
      "kind": "text",
      "x": 2,
      "y": 124,
      "emphasis": "muted",
      "content": "UP/DN pages  ENTER edit  hold=exit",
      "worst": "UP/DN pages  ENTER edit  hold=exit",
      "bound": "shared footer vocabulary, see 7.1",
      "bannerReplaces": true
    },
    {
      "id": "level-position",
      "kind": "scrollbar",
      "x": 232,
      "y": 14,
      "width": 5,
      "height": 100,
      "bound": "geometry; 100px so it stops clear of the banner row at y=116"
    }
  ]
}
