{
  "id": "config-s3-pulses-per-l",
  "name": "S3 \u2014 Pulses per litre",
  "description": "Sensor settings entry S3, scoped to the sensor of the current level. \u2014 laid out to the \u00a77 per-sensor template.",
  "elements": [
    {
      "id": "hdr-title",
      "kind": "text",
      "x": 2,
      "y": 2,
      "emphasis": "strong",
      "content": "Sensor > Pulses per litre",
      "worst": "Sensor > Pulses per litre",
      "bound": "fixed literal"
    },
    {
      "id": "nav-position",
      "kind": "text",
      "x": 168,
      "y": 2,
      "emphasis": "muted",
      "binding": "nav.position",
      "worst": "L3 8/8",
      "bound": "depth 0..3 (UiNavigator::kMaxDepth) and position within a ring of at most 8"
    },
    {
      "id": "sensor-index",
      "kind": "value",
      "x": 210,
      "y": 2,
      "binding": "config.selectedSensor",
      "worst": "8",
      "bound": "which sensor this setting applies to; 1..8, or - when none is implied"
    },
    {
      "id": "field-value",
      "kind": "value",
      "x": 2,
      "y": 24,
      "emphasis": "strong",
      "binding": "config.sensor.pulsesPerLiter",
      "worst": "65535 p/L",
      "bound": "uint16 domain 1..65535 with unit p/L"
    },
    {
      "id": "range-hint",
      "kind": "text",
      "x": 2,
      "y": 44,
      "emphasis": "muted",
      "binding": "config.editor.range",
      "worst": "None / Even / Odd",
      "bound": "derived from the descriptor - see 7.2; widest is parity"
    },
    {
      "id": "context-note",
      "kind": "text",
      "x": 2,
      "y": 66,
      "emphasis": "muted",
      "content": "Used when Calibration is Pulses/L.",
      "worst": "Used when Calibration is Pulses/L.",
      "bound": "fixed literal"
    },
    {
      "id": "nyquist-warning",
      "kind": "text",
      "x": 2,
      "y": 88,
      "emphasis": "strong",
      "binding": "config.sensor.nyquistWarning",
      "worst": "Write refused. UP=Back",
      "bound": "editor state; empty in the normal case"
    },
    {
      "id": "footer-hint",
      "kind": "text",
      "x": 2,
      "y": 124,
      "emphasis": "muted",
      "content": "UP/DN pages  ENTER edit  hold=exit",
      "worst": "UP/DN pages  ENTER edit  hold=exit",
      "bound": "shared footer vocabulary, see 7.1",
      "bannerReplaces": true
    },
    {
      "id": "level-position",
      "kind": "scrollbar",
      "x": 232,
      "y": 14,
      "width": 5,
      "height": 100,
      "bound": "geometry; 100px so it stops clear of the banner row at y=116"
    }
  ]
}
