# Ignore generated UI backups produced by exporter
backups/

# Ignore built web assets
web/mockup/dist/

# Node dependencies
node_modules/

.shirika/

# Exporter build output (regenerated by `npm run export:firmware`)
web/mockup/dist-exporter/

# Menu packs built by `npm run export:pack`, waiting to be copied onto an SD card. Build output, never
# source: the one pack that IS committed is tests/fixtures/default.uipack, which the firmware's host
# round trip reads and CI rebuilds and compares.
web/mockup/dist-pack/

# PlatformIO build tree
Water-Flow-Meter-PlatformIO/.pio/

# Screen captures for the wiki's Screen Gallery. CI captures them on every run and publishes them into
# the wiki, so they are never committed: see web/mockup/tools/screenshots/capture.mjs.
graphics/screens/

# Test/run artifacts
web/mockup/test-results/
web/mockup/server.log
web/mockup/test_output.txt

# Agent worktrees created by Workflow isolation — never source.
.claude/

# TypeScript incremental build cache.
*.tsbuildinfo

# The documentation gate's dependencies (tools/wiki/package.json). Its lockfile IS committed, so CI
# installs exactly what was verified locally.
tools/wiki/node_modules/
